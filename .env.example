# cp .env.example .env 로 시작한다. 값은 전부 로컬 개발용이다.

# --- DB -------------------------------------------------------------------
# compose 의 postgres. 호스트 포트를 바꿨다면(POSTGRES_PORT) 여기 포트도 같이 바꾼다.
DATABASE_URL=postgresql+asyncpg://prolog:prolog@localhost:5432/prolog

# --- 인증 -----------------------------------------------------------------
JWT_SECRET=dev-secret-change-me-with-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- 큐 · 스토리지 (compose 의 elasticmq · s3mock) -------------------------
# AWS 로 옮길 때는 두 ENDPOINT 를 비우고 실제 자격증명을 넣는다.
SQS_ENDPOINT_URL=http://localhost:9324
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=prolog-local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- compose 호스트 포트 (선택) -------------------------------------------
# 이미 쓰고 있는 포트와 겹칠 때만 지정한다. 예: 로컬 PostgreSQL 이 5432 를 점유한 경우
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# SQS_PORT=9324
# S3_PORT=9000

# --- AI (prolog-ai 패키지) ---------------------------------------------------
# 패키지는 .env 를 읽지 않는다. 앱이 이 값을 첫 호출 때 환경변수로 넘긴다(app/ai/client.py).
OPENROUTER_API_KEY=
# 비우면 패키지 기본값(deepseek/deepseek-v4-flash)
PROLOG_AI_MODEL=
# 로컬에서 API 없이 전 구간을 돌릴 때만 ai 워커 프로세스에 준다(빈 추출 결과가 나온다)
# USE_FAKE_LLM=1
